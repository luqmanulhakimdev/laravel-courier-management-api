{
  "info": {
    "_postman_id": "b18f5960-a22d-4876-9d3e-90818cb49f50",
    "name": "Courier Management API",
    "description": "Collection of requests for testing and interacting with the Courier Management API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "courier_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Couriers",
      "item": [
        {
          "name": "1. List Couriers (Default)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"]
            },
            "description": "Retrieve default paginated list of couriers sorted by name and id."
          }
        },
        {
          "name": "2. Search Couriers by Name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers?search=Budi+Agung",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"],
              "query": [
                {
                  "key": "search",
                  "value": "Budi+Agung"
                }
              ]
            },
            "description": "Search courier names case-insensitively with multi-term support."
          }
        },
        {
          "name": "3. Filter Couriers by Level",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers?level=2,3",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"],
              "query": [
                {
                  "key": "level",
                  "value": "2,3"
                }
              ]
            },
            "description": "Filter couriers matching levels 2 or 3."
          }
        },
        {
          "name": "4. Sort Couriers by Registered At (Newest First)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers?sort_by=registered_at",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"],
              "query": [
                {
                  "key": "sort_by",
                  "value": "registered_at"
                }
              ]
            },
            "description": "Sort couriers descending by registered_at."
          }
        },
        {
          "name": "5. Paginate Couriers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers?per_page=5&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Paginate couriers with custom per_page and page parameters."
          }
        },
        {
          "name": "6. Combined Search, Level, Sort & Pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers?search=budi&level=1,2,3&sort_by=registered_at&per_page=10&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"],
              "query": [
                {
                  "key": "search",
                  "value": "budi"
                },
                {
                  "key": "level",
                  "value": "1,2,3"
                },
                {
                  "key": "sort_by",
                  "value": "registered_at"
                },
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Combine all query parameters in a single request."
          }
        },
        {
          "name": "7. Create Courier (With registered_at)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Agung\",\n  \"phone\": \"081234567890\",\n  \"email\": \"budi.agung@example.com\",\n  \"address\": \"Jl. Sudirman No. 10, Jakarta\",\n  \"level\": 2,\n  \"registered_at\": \"2026-10-14 09:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"]
            },
            "description": "Create a new courier with custom registration timestamp."
          }
        },
        {
          "name": "8. Create Courier (Default registered_at)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siti Rahmawati\",\n  \"phone\": \"081298765432\",\n  \"email\": \"siti.rahma@example.com\",\n  \"address\": \"Jl. Asia Afrika No. 12, Bandung\",\n  \"level\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"]
            },
            "description": "Create a courier without registered_at; defaults to current time."
          }
        },
        {
          "name": "9. Get Courier by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers", "{{courier_id}}"]
            },
            "description": "Retrieve courier details by courier ID."
          }
        },
        {
          "name": "10. Full Update Courier (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Agung Pratama\",\n  \"phone\": \"081234567899\",\n  \"email\": \"budi.agung@example.com\",\n  \"address\": \"Jl. MH Thamrin No. 5, Jakarta Pusat\",\n  \"level\": 3,\n  \"registered_at\": \"2026-10-15 10:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers", "{{courier_id}}"]
            },
            "description": "Replace courier information (PUT requires name, phone, and level)."
          }
        },
        {
          "name": "11. Partial Update Courier (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi A. Pratama\",\n  \"level\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers", "{{courier_id}}"]
            },
            "description": "Partially update specific courier fields."
          }
        },
        {
          "name": "12. Clear Courier registered_at (PATCH null)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registered_at\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers", "{{courier_id}}"]
            },
            "description": "Clear the registered_at date by setting it to null."
          }
        },
        {
          "name": "13. Delete Courier",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers", "{{courier_id}}"]
            },
            "description": "Permanently delete a courier by ID."
          }
        }
      ]
    }
  ]
}
